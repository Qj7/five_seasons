# Vercel Postgres / Neon. The Neon integration on Vercel usually sets
# DATABASE_URL itself; POSTGRES_URL and POSTGRES_PRISMA_URL are also accepted.
# Without a URL the shop still opens (built-in catalog, cart and favorites
# stay in the browser). Orders, login, and account cart need the database.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Direct (non-pooled) connection for Prisma Migrate. Neon calls this
# POSTGRES_URL_NON_POOLING — that name works too.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
